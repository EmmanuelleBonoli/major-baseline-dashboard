DB_HOST_DEV=localhost
DB_PORT_DEV=3306
DB_NAME_DEV=devdb
DB_USER_DEV=user_dev
DB_PASSWORD_DEV=password_dev
CLIENT_URL_DEV=http://localhost:3000
API_URL_DEV=8080

DB_HOST_STAGING=staging.example.com
DB_PORT_STAGING=3306
DB_NAME_STAGING=stagingdb
DB_USER_STAGING=user_staging
DB_PASSWORD_STAGING=password_staging
CLIENT_URL_STAGING=https://staging.myapp.com
SERVER_PORT_STAGING=8080

DB_HOST_PROD=prod.example.com
DB_PORT_PROD=3306
DB_NAME_PROD=proddb
DB_USER_PROD=user_prod
DB_PASSWORD_PROD=password_prod
CLIENT_URL_PROD=https://myapp.com
API_URL_PROD=https://myapp.com
SERVER_PORT_PROD=8080

JWT_SECRET_KEY=your_secret_key
JWT_EXP_TIME=expiration_time
CONTACT_EMAIL_DESTINATION=[EMAIL_ADDRESS]

# SMTP (obligatoire — bloc spring.mail sans valeur par défaut)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=[EMAIL_ADDRESS]
MAIL_PASSWORD=[APP_PASSWORD]

# Identifiants stores — optionnels (services Store en mock), laisser vide si absents
GOOGLE_PLAY_SERVICE_ACCOUNT=
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY=
