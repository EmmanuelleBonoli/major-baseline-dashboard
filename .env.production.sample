# ─── Gabarit du .env de production — Major Baseline ───────────────────────────
# Copier en `.env` dans /home/ubuntu/major-baseline/ sur le VPS, puis `chmod 600 .env`.
# Consommé par docker-compose.prod.yml (interpolation Compose + env_file du backend).
# NE JAMAIS committer le .env rempli.

# ── Compose / déploiement ──
COMPOSE_PROJECT_NAME=major-baseline
APP_HOST=major-baseline.fr
# Écrasé par la CI (sha-xxxxxxx) ; garder `latest` pour un `up -d` manuel.
IMAGE_TAG=latest

# ── Base de données (conteneur mysql dédié de ce compose) ──
DB_HOST_PROD=mysql
DB_PORT_PROD=3306
DB_NAME_PROD=major_baseline_db
DB_USER_PROD=major_baseline
# Mot de passe applicatif — valeur forte (openssl rand -hex 24).
DB_PASSWORD_PROD=
# Mot de passe root MySQL — DIFFÉRENT de l'applicatif, valeur forte.
DB_ROOT_PASSWORD_PROD=

# ── URLs publiques (l'API est servie en same-origin sous /api/) ──
CLIENT_URL_PROD=https://major-baseline.fr
API_URL_PROD=https://major-baseline.fr

# ── Sécurité JWT ──
# >= 64 caractères aléatoires : openssl rand -hex 48
JWT_SECRET_KEY=
# Durée de validité du token, en millisecondes (3600000 = 1 h).
JWT_EXP_TIME=3600000

# ── Formulaire de contact ──
# Adresse qui reçoit les messages envoyés depuis /contact.
CONTACT_EMAIL_DESTINATION=

# ── SMTP (Gmail + mot de passe d'application) ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Ton adresse Gmail complète.
MAIL_USERNAME=
# Mot de passe d'application Google (16 caractères) — PAS le mot de passe du compte.
MAIL_PASSWORD=

# ── Intégrations stores — optionnelles (services en mock), laisser vide ──
GOOGLE_PLAY_SERVICE_ACCOUNT=
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY=
